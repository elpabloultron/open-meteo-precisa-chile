        "POSTGRES_USER": "postgres"
      }
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/home/pablo/Escritorio/open meteo precisa"
      ]
