# Configuración local. Nunca subas .env al repositorio.
APP_ENV=development
ALLOWED_ORIGINS="https://meteoprecisachile.web.app,https://meteoprecisachile.firebaseapp.com,http://localhost:5173"

# Datos que se actualizan una vez por hora.
# En local: CACHE_BACKEND=local. En Cloud Run: gcs y un bucket existente.
CACHE_BACKEND=local
CACHE_STORAGE_BUCKET=""
CACHE_STORAGE_OBJECT="cache/cache_servidor.json"
CACHE_REFRESH_SECONDS=60
ENABLE_IN_PROCESS_SYNC=false

# Credenciales de proveedores: define valores reales sólo en .env o Secret Manager.
USUARIO_DMC=""
TOKEN_DMC=""
PURPLEAIR_API_KEY=""
ADMIN_SYNC_TOKEN=""

# Google Earth Engine. En Cloud Run se recomienda ADC mediante una cuenta de servicio.
GCP_PROJECT_ID=""
GOOGLE_APPLICATION_CREDENTIALS=""
GEE_KEY_PATH=""